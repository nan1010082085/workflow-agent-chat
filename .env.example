CHAT_PORT=5301
MYSQL_DATABASE=workflow_agent_chat
MYSQL_USER=workflow_chat
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
RUNTIME_BASE_URL=http://host.docker.internal:30001
RUNTIME_WORKFLOW_KEY=
CHAT_CORS_ORIGINS=*
RUNTIME_MOCK_ENABLED=false
# 与 Schema Platform 共用（生产必填）
JWT_SECRET=change-me-to-match-platform
CHAT_AUTH_REQUIRED=true
CHAT_AUTH_HEADER_FALLBACK=false
# 宿主机附件目录（映射到容器 /data/agentChat）
CHAT_UPLOAD_HOST_PATH=/home/ubuntu/payflow/agentChat
CHAT_RATE_LIMIT_ENABLED=true
JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
